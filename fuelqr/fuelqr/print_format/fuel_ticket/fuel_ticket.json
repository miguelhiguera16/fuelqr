 "font_size": 14,
 "html": "<!-- \n    Print Format: Ticket de Combustible\n    DocType: Fuel Ticket\n    Tipo: Custom HTML\n-->\n\n<style>\n    /* \u2500\u2500 Reset y base \u2500\u2500 */\n    * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n    }\n\n    body {\n        font-family: \"Arial\", sans-serif;\n        font-size: 12px;\n        color: #1a1a1a;\n        background: #fff;\n    }\n\n    /* \u2500\u2500 Contenedor principal \u2500\u2500 */\n    .ticket-wrapper {\n        width: 100%;\n        max-width: 720px;\n        margin: 0 auto;\n        padding: 0;\n    }\n\n    /* \u2500\u2500 Header \u2500\u2500 */\n    .ticket-header {\n        background: #1a1a2e;\n        color: #fff;\n        padding: 20px 28px;\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        border-radius: 4px 4px 0 0;\n    }\n\n    .ticket-header .brand {\n        display: flex;\n        flex-direction: column;\n    }\n\n    .ticket-header .brand-name {\n        font-size: 26px;\n        font-weight: 700;\n        letter-spacing: 2px;\n        color: #f5a623;\n    }\n\n    .ticket-header .brand-sub {\n        font-size: 10px;\n        color: #aaa;\n        letter-spacing: 1px;\n        text-transform: uppercase;\n        margin-top: 2px;\n    }\n\n    .ticket-header .ticket-meta {\n        text-align: right;\n    }\n\n    .ticket-header .ticket-number {\n        font-size: 20px;\n        font-weight: 700;\n        color: #f5a623;\n        letter-spacing: 1px;\n    }\n\n    .ticket-header .ticket-date {\n        font-size: 10px;\n        color: #ccc;\n        margin-top: 4px;\n    }\n\n    /* \u2500\u2500 Status bar \u2500\u2500 */\n    .status-bar {\n        padding: 8px 28px;\n        font-size: 11px;\n        font-weight: 600;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n        display: flex;\n        align-items: center;\n        gap: 8px;\n    }\n\n    .status-bar.creado      { background: #e3f2fd; color: #1565c0; }\n    .status-bar.enviado     { background: #e3f2fd; color: #1565c0; }\n    .status-bar.pendiente   { background: #fff8e1; color: #f57f17; }\n    .status-bar.proximo     { background: #fff3e0; color: #e65100; }\n    .status-bar.vencido     { background: #fce4ec; color: #b71c1c; }\n    .status-bar.consumido   { background: #e8f5e9; color: #1b5e20; }\n    .status-bar.anulado     { background: #f5f5f5; color: #616161; }\n\n    .status-dot {\n        width: 8px;\n        height: 8px;\n        border-radius: 50%;\n        background: currentColor;\n        display: inline-block;\n    }\n\n    /* \u2500\u2500 Cuerpo principal \u2500\u2500 */\n    .ticket-body {\n        border: 1px solid #e0e0e0;\n        border-top: none;\n        border-radius: 0 0 4px 4px;\n        overflow: hidden;\n    }\n\n    /* \u2500\u2500 Layout de dos columnas \u2500\u2500 */\n    .ticket-content {\n        display: flex;\n        gap: 0;\n    }\n\n    /* \u2500\u2500 Columna izquierda: datos \u2500\u2500 */\n    .ticket-data {\n        flex: 1;\n        padding: 24px 28px;\n        border-right: 1px dashed #e0e0e0;\n    }\n\n    .section-title {\n        font-size: 9px;\n        font-weight: 700;\n        text-transform: uppercase;\n        letter-spacing: 1.5px;\n        color: #9e9e9e;\n        margin-bottom: 12px;\n        padding-bottom: 6px;\n        border-bottom: 1px solid #f0f0f0;\n    }\n\n    .data-group {\n        margin-bottom: 20px;\n    }\n\n    .data-row {\n        display: flex;\n        margin-bottom: 8px;\n        align-items: flex-start;\n    }\n\n    .data-label {\n        width: 120px;\n        font-size: 10px;\n        color: #757575;\n        font-weight: 600;\n        text-transform: uppercase;\n        letter-spacing: 0.5px;\n        flex-shrink: 0;\n        padding-top: 1px;\n    }\n\n    .data-value {\n        flex: 1;\n        font-size: 12px;\n        color: #1a1a1a;\n        font-weight: 500;\n        word-break: break-word;\n    }\n\n    .data-value.highlight {\n        font-size: 16px;\n        font-weight: 700;\n        color: #1a1a2e;\n    }\n\n    .data-value.danger {\n        color: #c62828;\n    }\n\n    /* \u2500\u2500 Barra de progreso de cantidad \u2500\u2500 */\n    .qty-section {\n        margin-top: 4px;\n    }\n\n    .qty-numbers {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 6px;\n    }\n\n    .qty-main {\n        font-size: 22px;\n        font-weight: 700;\n        color: #1a1a2e;\n    }\n\n    .qty-detail {\n        text-align: right;\n        font-size: 10px;\n        color: #757575;\n    }\n\n    .qty-detail span {\n        display: block;\n    }\n\n    .progress-bar {\n        height: 6px;\n        background: #e0e0e0;\n        border-radius: 3px;\n        overflow: hidden;\n        margin-bottom: 4px;\n    }\n\n    .progress-fill {\n        height: 100%;\n        background: #1a1a2e;\n        border-radius: 3px;\n        transition: width 0.3s;\n    }\n\n    .progress-label {\n        font-size: 9px;\n        color: #9e9e9e;\n        text-align: right;\n    }\n\n    /* \u2500\u2500 Columna derecha: QR \u2500\u2500 */\n    .ticket-qr {\n        width: 220px;\n        padding: 24px 20px;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        background: #fafafa;\n        flex-shrink: 0;\n    }\n\n    .qr-label {\n        font-size: 9px;\n        font-weight: 700;\n        text-transform: uppercase;\n        letter-spacing: 1.5px;\n        color: #9e9e9e;\n        margin-bottom: 12px;\n    }\n\n    .qr-image-container {\n        width: 160px;\n        height: 160px;\n        border: 2px solid #1a1a2e;\n        border-radius: 4px;\n        overflow: hidden;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        background: #fff;\n        padding: 6px;\n    }\n\n    .qr-image-container img {\n        width: 100%;\n        height: 100%;\n        object-fit: contain;\n        display: block;\n    }\n\n    .qr-placeholder {\n        font-size: 9px;\n        color: #bdbdbd;\n        text-align: center;\n        padding: 10px;\n    }\n\n    .short-code-section {\n        margin-top: 14px;\n        text-align: center;\n    }\n\n    .short-code-label {\n        font-size: 9px;\n        color: #9e9e9e;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n        margin-bottom: 4px;\n    }\n\n    .short-code-value {\n        font-size: 15px;\n        font-weight: 700;\n        letter-spacing: 3px;\n        color: #1a1a2e;\n        font-family: \"Courier New\", monospace;\n        background: #f0f0f0;\n        padding: 5px 10px;\n        border-radius: 3px;\n    }\n\n    .scan-hint {\n        font-size: 8px;\n        color: #bdbdbd;\n        text-align: center;\n        margin-top: 10px;\n        line-height: 1.4;\n    }\n\n    /* \u2500\u2500 Footer \u2500\u2500 */\n    .ticket-footer {\n        padding: 12px 28px;\n        background: #f5f5f5;\n        border-top: 1px solid #e0e0e0;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n    }\n\n    .footer-uuid {\n        font-size: 8px;\n        color: #bdbdbd;\n        font-family: \"Courier New\", monospace;\n        word-break: break-all;\n    }\n\n    .footer-validity {\n        font-size: 9px;\n        color: #757575;\n        text-align: right;\n        flex-shrink: 0;\n        margin-left: 16px;\n    }\n\n    .footer-validity.expired {\n        color: #c62828;\n        font-weight: 600;\n    }\n\n    /* \u2500\u2500 Sello de anulado \u2500\u2500 */\n    .cancelled-stamp {\n        position: absolute;\n        top: 50%;\n        left: 50%;\n        transform: translate(-50%, -50%) rotate(-30deg);\n        font-size: 48px;\n        font-weight: 900;\n        color: rgba(198, 40, 40, 0.15);\n        text-transform: uppercase;\n        letter-spacing: 6px;\n        pointer-events: none;\n        white-space: nowrap;\n    }\n\n    /* \u2500\u2500 Print \u2500\u2500 */\n    @media print {\n        .ticket-wrapper {\n            max-width: 100%;\n        }\n        .ticket-header {\n            -webkit-print-color-adjust: exact;\n            print-color-adjust: exact;\n        }\n        .status-bar {\n            -webkit-print-color-adjust: exact;\n            print-color-adjust: exact;\n        }\n    }\n</style>\n\n{%- set dispatched_pct = ((doc.qty_dispatched / doc.qty_authorized) * 100) | round | int if doc.qty_authorized else 0 -%}\n{%- set remaining_pct = 100 - dispatched_pct -%}\n\n{%- set status_class = {\n    \"Creado\":           \"creado\",\n    \"Enviado\":          \"enviado\",\n    \"Pendiente\":        \"pendiente\",\n    \"Pr\u00f3ximo a Vencer\": \"proximo\",\n    \"Vencido\":          \"vencido\",\n    \"Consumido\":        \"consumido\",\n    \"Anulado\":          \"anulado\"\n}.get(doc.status, \"pendiente\") -%}\n\n<div class=\"ticket-wrapper\">\n\n    <!-- Header -->\n    <div class=\"ticket-header\">\n        <div class=\"brand\">\n            <span class=\"brand-name\">FuelQR</span>\n            <span class=\"brand-sub\">Control de Despacho de Combustible</span>\n        </div>\n        <div class=\"ticket-meta\">\n            <div class=\"ticket-number\">{{ doc.name }}</div>\n            <div class=\"ticket-date\">Emitido: {{ frappe.format(doc.issued_on, \"Datetime\") }}</div>\n        </div>\n    </div>\n\n    <!-- Status Bar -->\n    <div class=\"status-bar {{ status_class }}\">\n        <span class=\"status-dot\"></span>\n        {{ doc.status | upper }}\n        {%- if doc.status == \"Anulado\" and doc.cancel_reason %}\n            &nbsp;\u2014 {{ doc.cancel_reason }}\n        {%- endif %}\n    </div>\n\n    <!-- Body -->\n    <div class=\"ticket-body\">\n        <div class=\"ticket-content\" style=\"position: relative;\">\n\n            {%- if doc.status == \"Anulado\" %}\n            <div class=\"cancelled-stamp\">ANULADO</div>\n            {%- endif %}\n\n            <!-- Columna izquierda: Datos -->\n            <div class=\"ticket-data\">\n\n                <!-- Empleado y Veh\u00edculo -->\n                <div class=\"data-group\">\n                    <div class=\"section-title\">Solicitante</div>\n                    <div class=\"data-row\">\n                        <span class=\"data-label\">Empleado</span>\n                        <span class=\"data-value highlight\">{{ frappe.db.get_value(\"Employee\", doc.employee, \"employee_name\") or doc.employee }}</span>\n                    </div>\n                    <div class=\"data-row\">\n                        <span class=\"data-label\">C\u00e9dula</span>\n                        <span class=\"data-value\">{{ frappe.db.get_value(\"Employee\", doc.employee, \"cedula\") or \"\u2014\" }}</span>\n                    </div>\n                    <div class=\"data-row\">\n                        <span class=\"data-label\">Departamento</span>\n                        <span class=\"data-value\">{{ doc.department }}</span>\n                    </div>\n                </div>\n\n                <!-- Veh\u00edculo -->\n                <div class=\"data-group\">\n                    <div class=\"section-title\">Veh\u00edculo</div>\n                    <div class=\"data-row\">\n                        <span class=\"data-label\">Placa</span>\n                        <span class=\"data-value highlight\">{{ doc.vehicle }}</span>\n                    </div>\n                    {%- set ficha = frappe.db.get_value(\"Vehicle\", doc.vehicle, \"ficha\") %}\n                    {%- if ficha %}\n                    <div class=\"data-row\">\n                        <span class=\"data-label\">Ficha</span>\n                        <span class=\"data-value\">{{ ficha }}</span>\n                    </div>\n                    {%- endif %}\n                    <div class=\"data-row\">\n                        <span class=\"data-label\">Combustible</span>\n                        <span class=\"data-value\">{{ doc.fuel_item }}</span>\n                    </div>\n                    <div class=\"data-row\">\n                        <span class=\"data-label\">Estaci\u00f3n</span>\n                        <span class=\"data-value\">{{ doc.station }}</span>\n                    </div>\n                </div>\n\n                <!-- Cantidad -->\n                <div class=\"data-group\">\n                    <div class=\"section-title\">Cantidad Autorizada</div>\n                    <div class=\"qty-section\">\n                        <div class=\"qty-numbers\">\n                            <span class=\"qty-main\">{{ doc.qty_authorized }} <small style=\"font-size:12px; font-weight:400; color:#757575;\">{{ doc.uom }}</small></span>\n                            <div class=\"qty-detail\">\n                                <span>Despachado: <strong>{{ doc.qty_dispatched }}</strong></span>\n                                <span>Restante: <strong>{{ doc.qty_remaining }}</strong></span>\n                            </div>\n                        </div>\n                        <div class=\"progress-bar\">\n                            <div class=\"progress-fill\" style=\"width: {{ dispatched_pct }}%;\"></div>\n                        </div>\n                        <div class=\"progress-label\">{{ dispatched_pct }}% consumido</div>\n                    </div>\n                </div>\n\n                <!-- Vigencia -->\n                <div class=\"data-group\">\n                    <div class=\"section-title\">Vigencia</div>\n                    <div class=\"data-row\">\n                        <span class=\"data-label\">Vence</span>\n                        <span class=\"data-value {% if doc.status in ['Vencido', 'Pr\u00f3ximo a Vencer'] %}danger{% endif %}\">\n                            {{ frappe.format(doc.expires_on, \"Datetime\") }}\n                        </span>\n                    </div>\n                    {%- if doc.fuel_request %}\n                    <div class=\"data-row\">\n                        <span class=\"data-label\">Solicitud</span>\n                        <span class=\"data-value\">{{ doc.fuel_request }}</span>\n                    </div>\n                    {%- endif %}\n                </div>\n\n            </div>\n\n            <!-- Columna derecha: QR -->\n            <div class=\"ticket-qr\">\n                <div class=\"qr-label\">Escanear para despachar</div>\n\n            <div class=\"qr-image-container\">\n            {%- if doc.qr_image %}\n                {%- set img_b64 = get_qr_image_base64(doc.name) %}\n                {%- if img_b64 %}\n                    <img src=\"data:image/png;base64,{{ img_b64 }}\" alt=\"QR {{ doc.name }}\" />\n                {%- else %}\n                    <div class=\"qr-placeholder\">QR no<br>disponible</div>\n                {%- endif %}\n            {%- else %}\n                <div class=\"qr-placeholder\">QR no<br>generado</div>\n            {%- endif %}\n            </div>\n\n                <div class=\"short-code-section\">\n                    <div class=\"short-code-label\">C\u00f3digo corto</div>\n                    <div class=\"short-code-value\">{{ doc.short_code or \"\u2014\" }}</div>\n                </div>\n\n                <div class=\"scan-hint\">\n                    Presente este ticket al<br>\n                    despachador para su validaci\u00f3n\n                </div>\n            </div>\n\n        </div>\n\n        <!-- Footer -->\n        <div class=\"ticket-footer\">\n            <div class=\"footer-uuid\">UUID: {{ doc.uuid }}</div>\n            <div class=\"footer-validity {% if doc.status == 'Vencido' %}expired{% endif %}\">\n                {%- if doc.status == \"Consumido\" %}\n                    \u2713 Ticket consumido\n                {%- elif doc.status == \"Anulado\" %}\n                    \u2717 Ticket anulado\n                {%- elif doc.status == \"Vencido\" %}\n                    \u2717 Ticket vencido\n                {%- else %}\n                    V\u00e1lido hasta {{ frappe.format(doc.expires_on, \"Date\") }}\n                {%- endif %}\n            </div>\n        </div>\n\n    </div>\n\n</div>",
